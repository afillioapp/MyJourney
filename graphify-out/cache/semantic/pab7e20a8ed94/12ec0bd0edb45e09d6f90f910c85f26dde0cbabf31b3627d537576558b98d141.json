{"nodes": [{"id": "docs_my_journey_concept", "label": "My Journey \u2014 Working Concept", "file_type": "document", "source_file": "docs/My-Journey-Concept.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Living decision record with dated decisions; sourced from Brainstorming docx files."}, {"id": "docs_my_journey_concept_my_journey", "label": "My Journey (product)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Photos sealed at capture, unlocking one year later; the product is about what happens when time becomes part of the product. Not attention, intention."}, {"id": "docs_my_journey_concept_three_jobs", "label": "Three Jobs (hope, appreciation, stop overthinking)", "file_type": "rationale", "source_file": "docs/My-Journey-Concept.md", "source_location": "L8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep hope alive through hard times, let people appreciate what they achieved, stop overthinking and worrying."}, {"id": "docs_my_journey_concept_low_usage_goal", "label": "Low Usage Is the Goal", "file_type": "rationale", "source_file": "docs/My-Journey-Concept.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stated publicly; no competitor can say it. Standard engagement metrics would read the product as failure; low usage is correct behaviour, not a retention problem."}, {"id": "docs_my_journey_concept_design_test", "label": "Design Test: Nobody Leaves Feeling Worse", "file_type": "rationale", "source_file": "docs/My-Journey-Concept.md", "source_location": "L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Users should leave hopeful, motivated, optimistic. Honest limit: never promise everything turns out fine, only that people kept going."}, {"id": "docs_my_journey_concept_core_message", "label": "Core Message: You've Come Further Than You Think", "file_type": "rationale", "source_file": "docs/My-Journey-Concept.md", "source_location": "L63", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "People do not see how far they have come; your own photo from a year ago is proof. Stronger than 'not attention, intention' because it is about the person."}, {"id": "docs_my_journey_concept_tone_self_recognition", "label": "Tone: Self-Recognition, Self-Progression, Self-Awareness", "file_type": "rationale", "source_file": "docs/My-Journey-Concept.md", "source_location": "L53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The axis it competes on vs Instagram's show-off instant. Nothing should ask the user to perform."}, {"id": "docs_my_journey_concept_ritual", "label": "The Ritual (Capture\u2192Seal\u2192Wait\u2192Reveal\u2192Reflect\u2192Preserve\u2192Repeat)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Whole journey sealed and unlocks once a year as a single event (2026-10-25). Photos only, in-app, no quality bar."}, {"id": "docs_my_journey_concept_delayed_perspective", "label": "Delayed Gratification + Delayed Perspective", "file_type": "rationale", "source_file": "docs/My-Journey-Concept.md", "source_location": "L91", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The reward is meeting who you were through the eyes of who you are now; delayed perspective is the stronger idea."}, {"id": "docs_my_journey_concept_journey_types", "label": "Three Journey Types", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L95", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replace the 24\u201348 range with difficulty levels (48/24/12), each halving the one above, to reach different audiences with the same ritual."}, {"id": "docs_my_journey_concept_explorer", "label": "Explorer (easy, 48/yr, 4 highlights)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L103", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For people used to instant photography, including teenagers."}, {"id": "docs_my_journey_concept_wanderer", "label": "Wanderer (normal, 24/yr, 2 highlights)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L104", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_my_journey_concept_contemplator", "label": "Contemplator (hard, 12/yr, 1 highlight)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L105", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For deliberate disconnectors wanting photos purely as commemoration."}, {"id": "docs_my_journey_concept_highlights", "label": "Highlights", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L107", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Limited 24h window where frame limit does not apply; capped at type's yearly quota; one open at a time. Open concern: cuts against scarcity."}, {"id": "docs_my_journey_concept_commit", "label": "Commit Button", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L111", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Commit carries weight Start/Create do not; choosing your own constraint is the first act of intention. Cannot be changed; journey runs 12 months from commit date."}, {"id": "docs_my_journey_concept_strict_capture_generous_reflect", "label": "Strict at Capture, Generous at Reflect", "file_type": "rationale", "source_file": "docs/My-Journey-Concept.md", "source_location": "L136", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Capture is three taps with no tagging or writing; all engagement lives at reveal, giving one real engagement moment a year. Front-of-deck pitch material."}, {"id": "docs_my_journey_concept_no_retakes", "label": "No Retakes Rule", "file_type": "rationale", "source_file": "docs/My-Journey-Concept.md", "source_location": "L142", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The moment is gone; users pushed to capture the moment, not get it right."}, {"id": "docs_my_journey_concept_reveal", "label": "Reveal (annual unlock)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L148", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Where engagement lives: first reflection, chapter/feeling tags, people tags, visibility. Choices set once and lock when reveal is finished."}, {"id": "docs_my_journey_concept_handwritten_note", "label": "Handwritten A4 Note", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L160", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Then-you's voice in own hand, photographed as the writing on the back. Optional skippable step up to 15 minutes after capture. Shift from handwriting to typed text is the passage of time."}, {"id": "docs_my_journey_concept_reflect", "label": "Reflect (per-photo yearly reflection)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L172", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One per photo per year, sealed, no edits, no comments from others; stacks forever. Never pushed. All photos move to next slot together on unlock anniversary."}, {"id": "docs_my_journey_concept_journey_overview", "label": "Journey Overview (Year Note)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L214", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Summary of how views changed over the year; one per journey per year, sealed, stacking, optional, readable by network."}, {"id": "docs_my_journey_concept_product_before_money", "label": "Company Philosophy: Product Before Money", "file_type": "rationale", "source_file": "docs/My-Journey-Concept.md", "source_location": "L237", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No engagement mechanics, no ads, no selling memories or data; revenue follows from being genuinely good."}, {"id": "docs_my_journey_concept_trust_memory_keeper", "label": "Trust as a Memory Keeper", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L251", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hardest promise is longevity; independence, never selling the archive, export guarantees, and the physical album as final trust layer."}, {"id": "docs_my_journey_concept_veja", "label": "Veja (independence reference)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L255", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_my_journey_concept_brand_language_yoga", "label": "Brand Language: Yoga and Vibration", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L265", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Borrow vocabulary from yoga rather than tech; 432 Hz as brand poetry only, not a health claim."}, {"id": "docs_my_journey_concept_circling_back", "label": "Circling Back", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L270", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The circle is the product's shape: anniversaries return, journeys repeat, layers are concentric rings."}, {"id": "docs_my_journey_concept_revenue_model", "label": "Revenue Model (print-shop subscription vs own printing)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L277", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Charge certified print shops monthly; reopened 2026-10-17 to consider owning printing or a hybrid due to chicken-and-egg shop economics."}, {"id": "docs_my_journey_concept_physical_album", "label": "Physical Album (1970s\u201390s family album)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L303", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two photos per page, thick pages, plastic sheet, handwritten names; shows the real year. Phase 2."}, {"id": "docs_my_journey_concept_print_shop_ritual", "label": "Print-Shop Ritual", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L314", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberate hassle echoing film drop-off; but no shop in a city is a wall, needs a fallback."}, {"id": "docs_my_journey_concept_journey_relationships", "label": "Journey Relationships (ME\u2192ME, ME\u2192YOU, ME\u2192IT, OTHERS\u2192ME)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L329", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ME\u2192YOU can be collected in secret."}, {"id": "docs_my_journey_concept_others_to_me", "label": "OTHERS \u2192 ME (hope from others)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L550", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Someone else got through it, so I can too; fourth relationship alongside ME\u2192OLD ME."}, {"id": "docs_my_journey_concept_user_profiles", "label": "User Profiles", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L342", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Disconnector, Life Chapter Keeper, Parent, Partner, Family member, Founder, Artist, Community."}, {"id": "docs_my_journey_concept_intentional_disconnector", "label": "Intentional Disconnector", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L346", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Placeholder name; alternatives The Returners, The Quiet Ones, Slow Keepers."}, {"id": "docs_my_journey_concept_visibility", "label": "Visibility (Private / Network / Public, per photo)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L365", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen at reveal because a year later you know how the year turned out. Network is default; public is readable, not commentable."}, {"id": "docs_my_journey_concept_layers", "label": "Layers (earned by crossing Journeys)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L393", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Concentric rings (Apple Watch menu), not followers; recalculated yearly; tight 5+, middle 2\u20134, outer 1; one-sided; drift one ring per journey with no crossing; never shown to the person on it; no face recognition."}, {"id": "docs_my_journey_concept_announcement_feed", "label": "Announcement Feed (three events)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L424", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "News not content: journey launched, reflection left, path crossed. No images, so nothing consumed passively."}, {"id": "docs_my_journey_concept_profile", "label": "Profile (the destination)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L442", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_my_journey_concept_positivity_feed", "label": "The Positivity Feed", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L450", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filtered by endurance and gratitude tags, fed only by public journeys; the reason to open the app during a sealed year. Protected from hardship-performance because reflections are written years later."}, {"id": "docs_my_journey_concept_chapter_tags", "label": "Chapter Tags (fixed categories)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L465", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Where you are; fixed so feeds stay findable; one per journey; organised under journey relationships."}, {"id": "docs_my_journey_concept_feeling_tags", "label": "Feeling Tags (free)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L463", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "How you are: hang in there, it eventually pays off, thankful, worried for nothing; free text, popular tags promoted over time."}, {"id": "docs_my_journey_concept_holmes_rahe", "label": "Holmes\u2013Rahe Life Stress Inventory", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L473", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_my_journey_concept_military_draft_story", "label": "Military Draft Founding Story", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L542", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'The hard part is just the first 2\u20133 days' \u2014 origin of the 'the hard part was the start' tag; must be in website and product DNA."}, {"id": "docs_my_journey_concept_walking_someones_path", "label": "Walking Someone's Path", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L563", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Track a Journey from beginning to now; a record, not advice. Discovering you were in someone's hardest year is a key payoff."}, {"id": "docs_my_journey_concept_capturing_low_points", "label": "Capturing the Low Points", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L584", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Invitation, never a nudge; a promise to yourself, proven a year later. Still open whether to encourage actively."}, {"id": "docs_my_journey_concept_the_path", "label": "The Path (timeline length, why start today)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L600", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Time can't be bought later; honest urgency; a copycat cannot give a user a path that begins in 2019."}, {"id": "docs_my_journey_concept_go_to_market", "label": "Go-to-Market Hypothesis (Valentine's Day secret Journeys)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L620", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1,000 disconnectors building secret journeys; revised to long-term vision since it gives no learning for 12 months. Short-loop first test still open."}, {"id": "docs_my_journey_concept_phasing", "label": "Phasing (all segments together; printing phase 2)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L637", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Launch message must unite segments via the ritual; phase 1 has no revenue line."}, {"id": "docs_my_journey_concept_founder_story", "label": "Founder Story (deactivated Instagram)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L655", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The medium was the problem, not the desire to capture or share."}, {"id": "docs_my_journey_concept_identity_usernames", "label": "Identity and User Names (names from within)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L665", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "We are all passengers; nothing on a profile signals looks or status. Avoid Native American naming appropriation. One name chosen once and kept (2026-10-25)."}, {"id": "docs_my_journey_concept_the_circle", "label": "The Circle (identity mark, rings, record not rank)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L681", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each year adds a ring framing the profile picture, like tree rings: tells age, never ranks. No leaderboards, badges, tiers."}, {"id": "docs_my_journey_concept_activity_line", "label": "Activity Line (twisted into the circle)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L702", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GitHub-contributor-style line bent into a ring at journey end; only appears after unlock, otherwise it would be a banned streak mechanic."}, {"id": "docs_my_journey_concept_naming", "label": "Naming (My Journey, originally Retrogram)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L718", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retrogram set aside; Journey fits normal speech; Journal, Chapter, Almanac, Keepsake, Unfold considered; trademark check needed."}, {"id": "docs_my_journey_concept_language_bank", "label": "Language Bank", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L729", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_my_journey_concept_pitch_deck", "label": "Pitch Deck as Family-Album Experience", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L750", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Interactive HTML album with page-turn; must state strict-at-capture, no retakes, low usage, 'this app takes time' early."}, {"id": "docs_my_journey_concept_defensibility", "label": "Defensibility (copy the feature, not the intent)", "file_type": "rationale", "source_file": "docs/My-Journey-Concept.md", "source_location": "L763", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Instagram can copy the feature but an attention-funded business cannot sell slowness. Candidate moats unproven; passes the remove-sharing stress test."}, {"id": "docs_my_journey_concept_instagram", "label": "Instagram (contrast reference)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L57", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_my_journey_concept_smallest_launch", "label": "Open Question: Smallest Launch Version", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L816", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only question still blocking anything; the thing to prove first is whether a group starts, keeps capturing, and still cares at reveal."}, {"id": "docs_my_journey_concept_upload_model_fork", "label": "Unresolved Fork: Upload Model vs Sealed Model", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L826", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Original voice note had upload-when-ready and feed of past years; concept doc removed both; current direction assumes sealed version."}, {"id": "docs_my_journey_concept_build_decisions_phase1", "label": "Build Decisions 2026-10-25 (Phase 1)", "file_type": "concept", "source_file": "docs/My-Journey-Concept.md", "source_location": "L836", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Settled for data model and fixtures; mirrors Functional-Spec.md \u00a720 and applied in Phase-1-Proposal.md. Supersedes several earlier decisions (start-of-year commit, per-photo reflection windows, close friends see everything, two-sided crossing, private default, yearly name change)."}], "edges": [{"source": "docs_my_journey_concept", "target": "docs_my_journey_concept_my_journey", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/My-Journey-Concept.md", "source_location": "L1", "weight": 1.0}, {"source": "docs_my_journey_concept_three_jobs", "target": "docs_my_journey_concept_my_journey", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/My-Journey-Concept.md", "source_location": "L10", "weight