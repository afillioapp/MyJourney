{"nodes": [{"id": "docs_functional_spec", "label": "Functional Spec", "file_type": "document", "source_file": "docs/Functional-Spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build reference; every behaviour traces to a decision in My-Journey-Concept.md, nothing invented to fill a gap"}, {"id": "docs_functional_spec_user", "label": "User (core object)", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Name comes from within, not physical attributes; nothing on a profile signals looks or how well someone is doing"}, {"id": "docs_functional_spec_journey", "label": "Journey (core object)", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_functional_spec_photo", "label": "Photo (core object)", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_functional_spec_handwritten_note", "label": "Handwritten Note", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional second step after capture so the moment is never held up; addable up to 15 minutes after capture (\u00a720 B, K)"}, {"id": "docs_functional_spec_reflection", "label": "Reflection", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Immutable, one per photo per year; you never rewrite your past self, you add a new one"}, {"id": "docs_functional_spec_journey_overview", "label": "Journey Overview", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_functional_spec_highlight", "label": "Highlight", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Limited 24-hour user-started window where the frame limit does not apply; capped at the type's yearly quota"}, {"id": "docs_functional_spec_tag", "label": "Tag (chapter / feeling)", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_functional_spec_layer", "label": "Layer (closeness ring)", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Earned, not chosen: computed from crossing journeys; drift outward is a feature, nobody drops off the map"}, {"id": "docs_functional_spec_open_signup", "label": "Open Signup", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_functional_spec_journey_types", "label": "Journey Types (Explorer / Wanderer / Contemplator)", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each step halves the one above; types sit on the old 24-48 range's ceiling, middle and floor"}, {"id": "docs_functional_spec_explorer", "label": "Explorer (4/month, 48/yr, 4 highlights)", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L40", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_functional_spec_wanderer", "label": "Wanderer (2/month, 24/yr, 2 highlights)", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L41", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_functional_spec_contemplator", "label": "Contemplator (1/month, 12/yr, 1 highlight)", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L42", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_functional_spec_commit", "label": "Commit", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The word Commit is deliberate and carries the weight; locks the type for the year, no default pre-selected, no abandoning"}, {"id": "docs_functional_spec_capture", "label": "Capture (three taps, no retakes)", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L51", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Photo taken in-app at the moment; no retakes, no quality bar, photos only, sealed automatically"}, {"id": "docs_functional_spec_frame_carry_forward", "label": "Frame Carry-Forward", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L261", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each journey month has its own limit; unused frames carry forward and lapse when the journey ends"}, {"id": "docs_functional_spec_sealed_year", "label": "The Sealed Year", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing visible to anyone including the owner; no previews, counts or thumbnails"}, {"id": "docs_functional_spec_reveal", "label": "Reveal", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L80", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The single annual engagement moment; layers recalculated only here"}, {"id": "docs_functional_spec_chapter_tags", "label": "Chapter Tags (ME\u2192ME, ME\u2192YOU, ME\u2192IT)", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L129", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_functional_spec_feeling_tags", "label": "Feeling Tags", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L131", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Free text; popular ones surface and best get promoted into official categories"}, {"id": "docs_functional_spec_no_face_recognition", "label": "No Face Recognition (manual people tagging)", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L127", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tagging people by hand is deliberate manual work"}, {"id": "docs_functional_spec_visibility_levels", "label": "Visibility Levels (Private / Network / Public)", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L139", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Set per photo at publish, not capture; Network default; public means readable, not commentable"}, {"id": "docs_functional_spec_feed", "label": "Feed (announcements only)", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L169", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No photographs; fires on journey launched, reflection left, path crossed; navigating to a journey must take a small deliberate act"}, {"id": "docs_functional_spec_profile_circle", "label": "Profile Circle and Rings", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L181", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One ring per year; a record not a rank: no scores, levels, leaderboards, badges"}, {"id": "docs_functional_spec_activity_graph", "label": "Activity Graph (after unlock only)", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L187", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A visible grid being filled is a streak mechanic and is banned"}, {"id": "docs_functional_spec_walking_a_path", "label": "Walking a Path", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L191", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_functional_spec_positivity_feed", "label": "Positivity Feed", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L200", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filtered by endurance and gratitude tags, never popularity; fed only by public journeys"}, {"id": "docs_functional_spec_album_and_print", "label": "Album and Print (phase 2)", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L213", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Print-shop ritual; the hassle is deliberate"}, {"id": "docs_functional_spec_system_enforced_rules", "label": "Rules the System Must Enforce", "file_type": "concept", "source_file": "docs/Functional-Spec.md", "source_location": "L224", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_functional_spec_system_must_never", "l